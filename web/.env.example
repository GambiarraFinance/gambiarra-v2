NEXT_PUBLIC_SITE_URL=https://gambiarra.finance

# Optional: dedicated BSC RPC for server-side reads. Public endpoints are the fallback.
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Optional: RPC used by the browser (WalletPanel). Public BSC by default.
# NEXT_PUBLIC_RPC_URL=https://bsc-dataseed.binance.org

# Dev fork. In `next dev` the app tries http://127.0.0.1:8545 first (chain id 56).
# Start it with: cd contracts && make fork
# BSC_FORK_RPC_URL=http://127.0.0.1:8545
# USE_BSC_FORK=0   # disables the fork even in development
